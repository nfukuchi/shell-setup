# ============================================================
# Mouse
# ============================================================

# Prefer native terminal drag-selection/copy. Prefix + m toggles mouse capture.
set -g mouse on
bind m set-option -g mouse \; display-message 'tmux mouse: #{?mouse,on,off}'

# tmuxでコピーした内容を端末のクリップボードにも送る
set -s set-clipboard external

# 外側の端末がOSC 52に対応していることをtmuxに伝える
set -as terminal-features ',xterm-256color:clipboard'

set -s copy-command 'wl-copy'

# vi style in tmux copy mode
set -g mode-keys vi


# ============================================================
# Pane movement
# Prefix + h/j/k/l
# ============================================================

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
