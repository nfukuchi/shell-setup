# ============================================================
# Mouse
# ============================================================

set -g mouse on

# vi style in tmux copy mode
set -g mode-keys vi


# ============================================================
# Pane movement
# Prefix + h/j/k/l
# ============================================================

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R


# ============================================================
# Mouse wheel
# ============================================================
#
# Behavior:
#
#   Claude / vim / TUI with mouse enabled
#       -> send wheel event to the application
#
#   Alternate-screen app without mouse handling
#       -> send Up / Down keys
#
#   Normal Bash shell
#       -> enter tmux copy mode and scroll history
#

bind -n WheelUpPane {
    if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' {
        send-keys -M
    } {
        if -F '#{alternate_on}' {
            send-keys -N 3 Up
        } {
            copy-mode -e
            send-keys -X -N 3 scroll-up
        }
    }
}

bind -n WheelDownPane {
    if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' {
        send-keys -M
    } {
        if -F '#{alternate_on}' {
            send-keys -N 3 Down
        }
    }
}